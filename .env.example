# Application Security & Environment Configuration
FLASK_DEBUG=False
SECRET_KEY=generate_a_random_production_secret_key_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_production_password

# Database Configuration (sqlite:///data/attendance.db or postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///data/attendance.db

# Server & Camera Setup
HOST=0.0.0.0
PORT=5000
CAMERA_INDEX=0
CONFIDENCE_THRESHOLD=75
COOLDOWN_SECONDS=300

